# =============================================================================
# hardcoders-ai-tinkerers — variables de entorno
# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env` a git.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# OpenRouter (obligatorio)
# Crea la key en https://openrouter.ai/settings/keys
# -----------------------------------------------------------------------------
# Formato: sk-or-v1-...
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Endpoint compatible con la API de OpenAI (usar como base_url / baseURL).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelo por defecto de la app. Siempre con prefijo de organización.
# Ejemplos: anthropic/claude-opus-5 | anthropic/claude-sonnet-5 |
#           anthropic/claude-haiku-4.5 | openai/gpt-6-astra | google/gemini-3.8-flash
# Con `:free` hay modelos gratuitos para pruebas (p. ej. nvidia/nemotron-3.5-lightning:free)
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Modelo barato para tareas simples (clasificar, resumir, routing).
OPENROUTER_FALLBACK_MODEL=anthropic/claude-haiku-4.5

# -----------------------------------------------------------------------------
# Atribución de app en OpenRouter (opcional pero recomendado)
# Se envían como headers HTTP-Referer y X-OpenRouter-Title.
# HTTP-Referer es obligatorio para aparecer en los rankings; si usas localhost,
# además debes mandar el título para que el uso se registre.
# -----------------------------------------------------------------------------
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=hardcoders-ai-tinkerers

# -----------------------------------------------------------------------------
# Compatibilidad con SDKs que solo leen las variables de OpenAI
# (openai-python, openai-node, Vercel AI SDK, LangChain, LlamaIndex...)
# Apuntan al mismo endpoint de OpenRouter: mismo valor que arriba.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Ajustes de generación (opcional)
# -----------------------------------------------------------------------------
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=debug
PORT=3000
